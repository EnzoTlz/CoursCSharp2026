@model List<Eval.Models.Prediction>

@{
    ViewData["Title"] = "Mes pronostics passés";
}

<div class="section-intro">
    <h1>Mes pronostics passés</h1>
    <p>Retrouve ici tes pronostics sur les matchs déjà commencés.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <p>Tu n'as pas encore de pronostic sur un match commencé.</p>
    </div>
}
else
{
    <div class="match-list">
        @foreach (var p in Model)
        {
            <div class="match-row history-row">
                <div class="match-teams">
                    <span class="team team-a">@p.Match.TeamA</span>
                    <span class="match-score">
                        @if (p.Match.IsPlayed)
                        {
                            <strong>@p.Match.ScoreA<span class="sep">:</span>@p.Match.ScoreB</strong>
                        }
                        else
                        {
                            <span class="vs">—</span>
                        }
                    </span>
                    <span class="team team-b">@p.Match.TeamB</span>
                </div>
                <div class="history-pred">
                    <span class="history-label">Ton prono</span>
                    <span class="history-value">@p.PredictedScoreA : @p.PredictedScoreB</span>
                </div>
                <div class="history-pts">
                    @if (p.Match.IsPlayed)
                    {
                        <span class="badge bg-primary">@p.PointsAwarded pts</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">En attente</span>
                    }
                </div>
            </div>
        }
    </div>
}