@model List<Eval.Models.Match>

@{
    ViewData["Title"] = "Espace admin";
}

<div class="section-intro">
    <h1>Espace admin</h1>
    <p>Gère les matchs et saisis les résultats. Les points sont recalculés automatiquement.</p>
</div>

@if (TempData["ImportOk"] != null)
{
    <div class="alert-ok">@TempData["ImportOk"]</div>
}
@if (TempData["ImportError"] != null)
{
    <div class="alert-err">@TempData["ImportError"]</div>
}

<div class="admin-import">
    <div>
        <strong>Synchroniser les scores depuis l'API</strong>
        <p>Récupère les matchs et résultats de la Coupe du Monde 2026. Ajoute les nouveaux matchs et met à jour les scores. Les pronostics sont conservés.</p>
    </div>
    <form asp-action="ImportFromApi" method="post"
          onsubmit="return confirm('Synchroniser les matchs et scores depuis l\'API ? Les pronostics seront conservés.');">
        <button type="submit" class="btn btn-primary">Synchroniser</button>
    </form>
</div>

<div class="admin-create">
    <h2 class="admin-create-title">Ajouter un match</h2>
    <form asp-action="CreateMatch" method="post" class="admin-create-form">
        <div class="admin-create-field">
            <label>Équipe A</label>
            <input type="text" name="teamA" class="form-control" placeholder="France" required />
        </div>
        <div class="admin-create-field">
            <label>Équipe B</label>
            <input type="text" name="teamB" class="form-control" placeholder="Brésil" required />
        </div>
        <div class="admin-create-field">
            <label>Coup d'envoi</label>
            <input type="datetime-local" name="kickoff" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Ajouter</button>
    </form>
</div>

<h2 class="admin-list-title">Matchs existants</h2>

<div class="match-list">
    @foreach (var match in Model)
    {
        <div class="match-row admin-row">
            <div class="match-date">
                <span class="match-day">@match.KickoffUtc.ToString("dd/MM")</span>
                <span class="match-time">@match.KickoffUtc.ToString("HH:mm")</span>
            </div>
            <div class="admin-match-teams">
                <span class="team">@match.TeamA</span>
                <span class="vs-small">vs</span>
                <span class="team">@match.TeamB</span>
            </div>
            <form asp-action="SetScore" method="post" class="admin-form">
                <input type="hidden" name="matchId" value="@match.Id" />
                <input type="number" name="scoreA" min="0" value="@(match.ScoreA ?? 0)" class="form-control admin-score" />
                <span class="sep">:</span>
                <input type="number" name="scoreB" min="0" value="@(match.ScoreB ?? 0)" class="form-control admin-score" />
                <button type="submit" class="btn btn-gold btn-sm">Score</button>
            </form>
            <form asp-action="DeleteMatch" method="post" class="admin-delete-form"
                  onsubmit="return confirm('Supprimer ce match ? Les pronostics liés seront aussi supprimés.');">
                <input type="hidden" name="matchId" value="@match.Id" />
                <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
            </form>
        </div>
    }
</div>