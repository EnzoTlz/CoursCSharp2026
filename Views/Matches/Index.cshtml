@model List<Eval.Models.Match>

@{
    ViewData["Title"] = "Les matchs";
}

<div class="section-intro">
    <h1>Matchs de la Coupe du Monde 2026</h1>
    <p>Pronostique les scores et grimpe au classement.</p>
</div>

<div class="match-list">
    @foreach (var match in Model)
    {
        <div class="match-row">
            <div class="match-date">
                <span class="match-day">@match.KickoffUtc.ToString("dd/MM")</span>
                <span class="match-time">@match.KickoffUtc.ToString("HH:mm")</span>
            </div>
            <div class="match-teams">
                <span class="team team-a">@match.TeamA</span>
                <span class="match-score">
                    @if (match.IsPlayed)
                    {
                        <strong>@match.ScoreA<span class="sep">:</span>@match.ScoreB</strong>
                    }
                    else
                    {
                        <span class="vs">VS</span>
                    }
                </span>
                <span class="team team-b">@match.TeamB</span>
            </div>
            <div class="match-status">
                @if (match.IsPlayed)
                {
                    <span class="badge bg-secondary">Terminé</span>
                }
                else if (match.KickoffUtc <= DateTime.Now)
                {
                    <span class="badge bg-warning">En cours</span>
                }
                else
                {
                    <span class="badge bg-success">À venir</span>
                }
            </div>
        </div>
    }
</div>